{
  "name": "easycron",
  "version": "0.0.4",
  "private": true,
  "scripts": {
    "build": "next build --experimental-build-mode compile",
    "build:dev": "ENVIRONMENT=development op run --env-file=\".env.op\" --no-masking -- next build",
    "build:scheduler": "tsup scheduler/index.ts --config tsup.scheduler.config.ts --tsconfig tsconfig.scheduler.json",
    "build:worker": "tsup worker/index.ts --config tsup.worker.config.ts --tsconfig tsconfig.worker.json",
    "checks": "chmod +x $(git rev-parse --show-toplevel)/scripts/checks.sh && $(git rev-parse --show-toplevel)/scripts/checks.sh",
    "db:create-default-orgs": "ENVIRONMENT=development op run --env-file=\".env.op\" --no-masking -- tsx src/db/scripts/create-default-orgs.ts",
    "db:generate": "drizzle-kit generate --config=./src/db/drizzle.config.ts",
    "db:migrate": "ENVIRONMENT=development op run --env-file=\".env.op\" -- drizzle-kit migrate --config=./src/db/drizzle.config.ts",
    "db:migrate-resources-to-orgs": "ENVIRONMENT=development op run --env-file=\".env.op\" --no-masking -- tsx src/db/scripts/migrate-resources-to-orgs.ts",
    "db:studio": "ENVIRONMENT=development op run --env-file=\".env.op\" -- drizzle-kit studio --config=src/db/drizzle.config.ts",
    "decrypt:secrets": "ENVIRONMENT=development op run --env-file=\".env.op\" --no-masking -- tsx src/db/scripts/encrypt-decrypt-secrets.ts",
    "dev": "ENVIRONMENT=development op run --env-file=\".env.op\" --no-masking -- next dev --turbopack",
    "dev:email": "email dev --dir src/email/emails --port 3001",
    "dev:scheduler": "ENVIRONMENT=development op run --env-file=\".env.op\" --no-masking -- tsx scheduler/index.ts",
    "dev:services": "chmod +x $(git rev-parse --show-toplevel)/scripts/start-services-dev.sh && $(git rev-parse --show-toplevel)/scripts/start-services-dev.sh",
    "dev:worker": "ENVIRONMENT=development op run --env-file=\".env.op\" --no-masking -- tsx worker/index.ts",
    "fetch:env": "ENVIRONMENT=development op inject -i .env.op -o .env",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:encryption-key": "chmod +x $(git rev-parse --show-toplevel)/scripts/generate-encryption-key.sh && $(git rev-parse --show-toplevel)/scripts/generate-encryption-key.sh",
    "lint": "next lint",
    "pipeline": "chmod +x $(git rev-parse --show-toplevel)/scripts/pipeline.sh && $(git rev-parse --show-toplevel)/scripts/pipeline.sh",
    "send:info-email": "ENVIRONMENT=development op run --env-file=\".env.op\" --no-masking -- tsx src/email/send-info.tsx",
    "start": "next start",
    "start:dev": "ENVIRONMENT=development op run --env-file=\".env.op\" --no-masking -- next start",
    "start:scheduler": "ENVIRONMENT=development op run --env-file=\".env.op\" --no-masking -- node dist/scheduler/index.js",
    "start:worker": "ENVIRONMENT=development op run --env-file=\".env.op\" --no-masking -- node dist/worker/index.js",
    "test": "vitest --run",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "2.0.42",
    "@better-auth/passkey": "1.4.17",
    "@better-auth/stripe": "1.4.17",
    "@better-fetch/fetch": "1.1.21",
    "@hono/standard-validator": "0.1.5",
    "@hono/zod-validator": "0.7.4",
    "@hookform/resolvers": "5.2.1",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-avatar": "1.1.10",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tooltip": "1.2.8",
    "@react-email/components": "0.5.5",
    "@sentry/nextjs": "^10",
    "@t3-oss/env-nextjs": "0.13.8",
    "@tanstack/react-query": "5.90.2",
    "ai": "5.0.60",
    "bcrypt": "6.0.0",
    "better-auth": "1.4.17",
    "bowser": "2.12.1",
    "bullmq": "5.58.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cron-parser": "5.4.0",
    "cronstrue": "3.3.0",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.44.4",
    "hono": "4.10.5",
    "import-in-the-middle": "3.0.0",
    "ioredis": "5.8.0",
    "lucide-react": "0.511.0",
    "nanoid": "5.1.6",
    "next": "15.5.7",
    "next-intl": "4.3.9",
    "next-themes": "0.4.6",
    "node-mailjet": "6.0.9",
    "nodemailer": "7.0.6",
    "pg": "8.16.3",
    "radix-ui": "1.4.3",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "7.62.0",
    "react-qr-code": "2.0.18",
    "recharts": "2.15.4",
    "redis": "5.8.2",
    "require-in-the-middle": "8.0.1",
    "sonner": "2.0.7",
    "stripe": "18.5.0",
    "tailwind-merge": "3.3.1",
    "tw-animate-css": "1.2.5",
    "undici": "7.16.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@jackjakarta/prettier-config": "0.3.0",
    "@react-email/preview-server": "4.2.11",
    "@tailwindcss/postcss": "4.0.17",
    "@types/bcrypt": "6.0.0",
    "@types/node": "22.13.14",
    "@types/nodemailer": "7.0.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.1",
    "drizzle-kit": "0.31.4",
    "eslint": "9.34.0",
    "eslint-config-next": "15.4.2",
    "jsdom": "27.0.0",
    "react-email": "4.2.11",
    "tailwindcss": "4.1.12",
    "tsup": "8.5.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@9.15.3"
}
